Version: 1.0
ProjectId: 456a2037-d8a1-45fc-8a2d-f92b47951f76

RestoreWorkspace: No
SaveWorkspace: No
AlwaysSaveHistory: Default

EnableCodeIndexing: Yes
UseSpacesForTab: Yes
NumSpacesForTab: 2
Encoding: UTF-8

RnwWeave: Sweave
LaTeX: pdfLaTeX

AutoAppendNewline: Yes

BuildType: Package
PackageUseDevtools: Yes
PackageInstallArgs: --no-multiarch --with-keep.source
PackageCheckArgs: --no-examples
PackageRoxygenize: rd,collate,namespace

MarkdownWrap: Column
MarkdownWrapAtColumn: 120
